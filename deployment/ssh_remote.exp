#!/usr/bin/expect -f
set timeout -1

set ssh_host $env(PROXMOX_HOST)
set ssh_pass $env(PROXMOX_ROOT_PASS)

spawn ssh -o StrictHostKeyChecking=no root@$ssh_host
expect "*?assword:*"
send "$ssh_pass\r"
expect "# "
send "cd /root/aziza-build\r"
expect "# "
send "ls -la\r"
expect "# "
send "screen -ls\r"
expect "# "
interact
