#!/usr/bin/expect -f
set timeout -1

set ssh_host $env(AZIZA_SSH_HOST)
set ssh_pass $env(AZIZA_SSH_PASS)

spawn ssh -o StrictHostKeyChecking=no aziza@$ssh_host
expect "password"
send "$ssh_pass\r"
expect "$ "
send "sudo su -\r"
expect "password"
send "$ssh_pass\r"
expect "# "
send "pm2 list\r"
expect "# "
send "exit\r"
expect "$ "
send "exit\r"
expect eof
