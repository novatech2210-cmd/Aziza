# Aziza-web env config (lives at /workspace/aziza-web/config/.env).
# Mirrors the env vars Kyo's DEPLOY.md describes; install.sh seeds this
# file on first run, then leaves it alone.

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Postgres ---------------------------------------------------------------
# install.sh substitutes this with the password it generated.
DATABASE_URL=postgresql://aziza:CHANGE_ME@localhost:5432/aziza_db

# --- JWT (CRITICAL — must be unique per deploy) -----------------------------
# Generate with: openssl rand -hex 32
# Kyo's repo ships a default ("qube-phase4-secret-change-me") which is a
# known weak secret — do NOT leave the default in any deploy.
JWT_SECRET=CHANGE_ME_RANDOM_32_BYTES_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM (Google Gemini API — Kyo's chat path) ------------------------------
# This is HIS Gemini key for HIS chat module. Telephony's dialogue-engine
# uses a separate local LLM (vLLM + Vikhr) and does NOT need this key.
# Kyo flagged a leaked key in his repo on 2026-05-22; ensure he provides
# a freshly-rotated one for this deploy.
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash-lite

# --- ASR (Whisper) ----------------------------------------------------------
ASR_ENABLED=true
ASR_MODEL=hostmepanda/whisper-large-v3-turbo-uzbek-ct2
ASR_DEVICE=cuda
ASR_DEVICE_INDEX=0
ASR_COMPUTE_TYPE=float16

# --- TTS (Microsoft Edge — cloud, free, no key) ----------------------------
TTS_ENABLED=true

# --- RAG --------------------------------------------------------------------
RAG_ENABLED=true
RAG_INDEX_PATH=/workspace/aziza-web/rag_index
RAG_TOP_K=5
RAG_EMBED_MODEL=BAAI/bge-m3

# --- CORS -------------------------------------------------------------------
# Permissive for dev; tighten for production.
CORS_ORIGINS=*

# --- Where Whisper/sentence-transformers cache lives (persistent volume) ----
HF_HOME=/workspace/aziza-web/models
TRANSFORMERS_CACHE=/workspace/aziza-web/models
SENTENCE_TRANSFORMERS_HOME=/workspace/aziza-web/models
