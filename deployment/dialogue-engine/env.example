# telephony-llm service env config (lives at /workspace/telephony-llm/config/.env).
# Copy this file there and fill in the secrets — install.sh seeds it on first
# run if absent, then leaves it alone on re-runs.

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8020
LOG_LEVEL=INFO

# --- RAG (Kyo's aziza-web on the same VPS, over localhost) ------------------
# When co-located on Kyo's server, this is the LOCAL aziza port.
RAG_URL=http://127.0.0.1:8000
# Service-account JWT — obtain via Kyo's /login endpoint with the
# admin credentials he provisioned. Refresh handled by RAGClient.
RAG_AUTH_TOKEN=
RAG_TIMEOUT_S=10
RAG_TOP_K=5

# --- LLM (local vLLM) -------------------------------------------------------
# The vLLM server should run as a separate process on the same VPS,
# bound to localhost. Start it BEFORE telephony-llm.service starts (the
# systemd unit's After= doesn't auto-start vLLM — that's a follow-up
# unit, see deploy/vps/deploy-all.sh).
LLM_URL=http://127.0.0.1:8001
# AWQ quantization: ~5 GB on disk + ~6 GB VRAM. Telephony only needs short
# answers; AWQ is the right scale/cost trade. install.sh downloads this repo.
# Switch to "Vikhrmodels/Vikhr-Llama3.1-8B-Instruct-R-21-09-24" (FP16) on bigger instances if needed.
LLM_MODEL=Vikhrmodels/Vikhr-Llama3.1-8B-Instruct-R-21-09-24-AWQ
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_S=30

# --- Conversation state -----------------------------------------------------
STATE_BACKEND=memory
REDIS_URL=
HISTORY_MAX_TURNS=10
