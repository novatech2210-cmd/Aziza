; pjsip.secrets.conf.example — TEMPLATE
;
; Real credentials live in pjsip.secrets.conf (gitignored).
; First-time setup:
;   1. Copy this file: cp pjsip.secrets.conf.example pjsip.secrets.conf
;   2. Replace REPLACE_ME with the real Nano password (held privately by
;      Ivan / project lead).
;   3. Run ./push.ps1 — push.ps1 detects pjsip.secrets.conf and SCPs it
;      alongside pjsip.conf.
;
; Never commit pjsip.secrets.conf. The .gitignore in this folder blocks it
; by name, but always double-check `git status` before committing.

[trunk_nano_auth]
type = auth
auth_type = userpass
username = 712051245
password = REPLACE_ME
